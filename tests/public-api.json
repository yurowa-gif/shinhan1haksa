    "importSeatGrid":    { "use": "화면",   "guard": "requirePermission_" },
    "assignSeat":        { "use": "화면",   "guard": "requirePermission_" },
    "swapSeats":         { "use": "화면",   "guard": "requirePermission_" },
    "unassignSeat":      { "use": "화면",   "guard": "requirePermission_" },
    "saveDaySchedule":   { "use": "화면",   "guard": "requirePermission_" },
    "cancelDaySchedule": { "use": "화면",   "guard": "requirePermission_" },
    "previewRoster":     { "use": "화면",   "guard": "requirePermission_" },
    "spikeRunAll":       { "use": "편집기", "guard": "assertOwnerRun_" },
    "spikeGetHtml":      { "use": "화면",   "guard": "assertOwnerRun_" },
    "spikeGetPdfBase64": { "use": "화면",   "guard": "assertOwnerRun_" },
    "spikeGetPdfLink":   { "use": "화면",   "guard": "assertOwnerRun_" }
  }
